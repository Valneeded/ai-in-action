        {
          "_name": "steps1",
          "_sourceTheme": "marketm4",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card": {
              "width": "100%"
            },
            "& when (@addBlockAmount = \"1\")": {
              ".card:nth-child(odd)": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            "& when (@addBlockAmount = \"2\")": {
              ".card:nth-child(even)": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            "& when (@addBlockAmount = \"4\")": {
              ".card": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            ".add__block": {
              "margin-top": "35px",
              ".add__block_image": {
                "width": "170px",
                "img": {
                  "width": "100%",
                  "border-radius": "6px"
                }
              },
              ".add__block_content": {
                "margin-left": "30px",
                "max-width": "270px"
              },
              ".add__block_title": {
                "margin-bottom": "0"
              },
              ".add__block_text": {
                "margin-top": "15px",
                "margin-bottom": "0",
                "color": "#919dab"
              }
            },
            ".row": {
              "margin": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "0"
            },
            ".step-container": {
              "margin-top": "25px"
            },
            ".padding__bot": {
              "padding-bottom": "50px"
            },
            ".step-text-content": {
              "padding-top": "10px"
            },
            ".mbr-step-title": {
              "margin-bottom": "0",
              "font-weight": "500",
              "color": "#d70081"
            },
            ".mbr-step-text": {
              "margin-bottom": "0",
              "margin-top": "20px",
              "color": "#232323"
            },
            ".mbr-section-btn": {
              "margin-top": "20px",
              ".btn": {
                "font-weight": "500"
              }
            },
            ".step": {
              "display": "flex",
              "width": "(@stepSize * 2px)",
              "height": "(@stepSize * 2px)",
              "font-size": "~\"calc((@{stepSize}px) - 2px)\"",
              "margin-bottom": "0",
              "border-radius": "50%",
              "border": "2px solid @lineColor",
              "background-color": "@lineColor",
              "font-weight": "500",
              "color": "#000000",
              "& when (@stepSize > 24px)": {
                "@media (max-width: 767px)": {
                  "width": "48px",
                  "height": "48px",
                  "font-size": "24px"
                }
              }
            },
            "@media (min-width: 400px)": {
              ".add__block": {
                "display": "flex"
              },
              ".step-element": {
                "display": "flex"
              },
              ".mbr-section-btn": {
                "margin-top": "20px",
                "margin-left": "~\"calc((@{stepSize} * 2px) + 70px)\"",
                ".btn": {
                  "margin-left": "0"
                }
              },
              ".separline": {
                "position": "relative",
                "&:after": {
                  "top": "(@stepSize * 2px)",
                  "left": "(@stepSize - 2px)",
                  "position": "absolute",
                  "content": "\"\"",
                  "width": "2px",
                  "height": "~\"calc(100% - (@{stepSize}px) * 2)\"",
                  "background-color": "@lineColor",
                  "& when (@stepSize > 24px)": {
                    "@media (max-width: 767px)": {
                      "top": "52px",
                      "left": "22px",
                      "height": "~\"calc(100% - 56px)\""
                    }
                  }
                }
              },
              ".step-text-content": {
                "margin-left": "70px"
              }
            },
            "@media (max-width: 400px)": {
              ".add__block_title": {
                "margin-top": "30px"
              },
              ".add__block": {
                ".add__block_content": {
                  "margin-left": "0"
                }
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"steps1 marketm4_steps1\" group=\"Steps\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Step Title\" name=\"showStepTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Step Text\" name=\"showStepText\" checked>\n\t\t<input type=\"checkbox\" title=\"Show Button\" name=\"showButtons\">\n\t\t<input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#edefeb\">\n\t\t<select title=\"Steps Count\" name=\"stepsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t</select>\n\t\t<input type=\"range\" inline title=\"Step Size\" name=\"stepSize\" min=\"10\" max=\"30\" step=\"1\" value=\"20\">\n\t\t<select title=\"Show Image\" name=\"addBlockAmount\">\n\t\t\t<option value=\"1\">odd</option>\n\t\t\t<option value=\"2\">even</option>\n\t\t\t<option value=\"3\">all</option>\n\t\t\t<option value=\"4\" selected>none</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg1.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-xl-10 col-lg-11\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n\t\t\t\t\tDía 01 / 07.05</h2>\n\n\t\t\t\t<div class=\"step-container\">\n\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t<div class=\"card\" mbr-class=\"{'separline padding__bot': stepsAmount > '1'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">•</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">12:15 - 13:00 pm - Ponencia<br><b>Ethic - Responsible AI</b></h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\"><b>Olivia</b> <b>Gambelin</b><br>Autora de \"IA Responsable” y conferencista.</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/pasted-image-11-380x380.png\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">JUAN ENRIQUEZ</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">Managing Director at Excel Venture Management, LLC<br></p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 1\" mbr-class=\"{'separline padding__bot': stepsAmount > '2'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">•</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">13:00 - 13.30 pm&nbsp;</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">Coffee Break</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/brian-green-1-320x320.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">Bernardo González</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tProfessor at Columbia Business School\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 2\" mbr-class=\"{'separline padding__bot': stepsAmount > '3'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">•</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">13.30 - 14.15 pm - Videoconferencia<br><div><b>Emotional Intelligence.</b></div></h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\"><b>Daniel Goleman </b><br>Consultor Senior y Director de los cursos en línea de Inteligencia Emocional de Daniel Goleman.</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/bernardo-gonzalez--560x560.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tBERNARDO GONZALEZ</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tDirector de Innovación, Kio Networks</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 3\" mbr-class=\"{'separline padding__bot': stepsAmount > '4'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">Ev</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">19:00 - 22.00 pm - Evento<div><b>Premios DEVA 2025.</b></div></h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\"><b>Entrega de Premios</b>.</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/charlene-li-leadership-speaker-462x462.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">CHARLENE LI</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tCatalyzing transformation to maximize human potential as an author, speaker, advisor, and coach.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 4\" mbr-class=\"{'separline padding__bot': stepsAmount > '5'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">5</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">10:30 - 10.45 am</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">Coffee Break</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/design5.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tOUR DESIGN\n\t\t\t\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat\n\t\t\t\t\t\t\t\t\t\t\t\tlibero, bibendum in libero.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 5\" mbr-class=\"{'separline padding__bot': stepsAmount > '6'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">6</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">11:00 - 11.45 am - Ponencia<br><b>Panel de Casos</b></h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">Case Real Madrid<br>Case TBD<br>Case Palantir</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/design5.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tOUR DESIGN\n\t\t\t\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat\n\t\t\t\t\t\t\t\t\t\t\t\tlibero, bibendum in libero.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 6\" mbr-class=\"{'separline padding__bot': stepsAmount > '7'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">7</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">11:45 - 12.00 am</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">\n\t\t\t\t\t\t\t\t\t\tCoffee Break\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/design5.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tOUR DESIGN\n\t\t\t\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat\n\t\t\t\t\t\t\t\t\t\t\t\tlibero, bibendum in libero.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 7\" mbr-class=\"{'separline padding__bot': stepsAmount > '8'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">8</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">\n\t\t\t\t\t\t\t\t\t\tDeployment\n\t\t\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">\n\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat libero,\n\t\t\t\t\t\t\t\t\t\tbibendum in libero tempor, luctus\n\t\t\t\t\t\t\t\t\t\tvolutpat ligula. Integer fringilla porttitor pretium. Nam erat felis, iaculis id\n\t\t\t\t\t\t\t\t\t\tjusto ut, ullamcorper feugiat\n\t\t\t\t\t\t\t\t\t\telit. Proin vel lectus auctor, porttitor ligula vitae, convallis leo. In eget\n\t\t\t\t\t\t\t\t\t\tmassa elit.\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/design5.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tOUR DESIGN\n\t\t\t\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat\n\t\t\t\t\t\t\t\t\t\t\t\tlibero, bibendum in libero.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 8\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">9</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">\n\t\t\t\t\t\t\t\t\t\tDeployment\n\t\t\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">\n\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat libero,\n\t\t\t\t\t\t\t\t\t\tbibendum in libero tempor, luctus\n\t\t\t\t\t\t\t\t\t\tvolutpat ligula. Integer fringilla porttitor pretium. Nam erat felis, iaculis id\n\t\t\t\t\t\t\t\t\t\tjusto ut, ullamcorper feugiat\n\t\t\t\t\t\t\t\t\t\telit. Proin vel lectus auctor, porttitor ligula vitae, convallis leo. In eget\n\t\t\t\t\t\t\t\t\t\tmassa elit.\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/design5.jpg\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">\n\t\t\t\t\t\t\t\t\t\t\t\tOUR DESIGN\n\t\t\t\t\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">\n\t\t\t\t\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipiscing elit. Nam erat\n\t\t\t\t\t\t\t\t\t\t\t\tlibero, bibendum in libero.\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\t\t\t\t\t\t<a class=\"btn btn-md btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_anchor": "steps1-43",
          "_isUserblock": true,
          "_cid": "uBLyATwO2Z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "apricing10",
          "_sourceTheme": "shopm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "3rem"
            },
            ".mbr-section-title": {
              "color": "#FFFFFF",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "margin-top": "1rem",
              "color": "#FFFFFF"
            },
            ".row": {
              "row-gap": "32px"
            },
            ".card": {
              "border-radius": "0"
            },
            ".card-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "padding": "2rem",
              "height": "100%",
              "width": "100%",
              "background-color": "@cardBg"
            },
            ".card-title-wrap": {
              "width": "100%",
              "margin-bottom": "16px",
              "& when (@showBorder)": {
                "padding-bottom": "16px",
                "border-bottom": "1px solid @cardBorderColor"
              }
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-subtitle": {
              "color": "#232323"
            },
            ".mbr-text": {
              "margin-top": "16px",
              "color": "#24262b"
            },
            ".card-number-wrap": {
              "display": "flex",
              "align-items": "center",
              "width": "100%"
            },
            ".price-text": {
              "color": "#24262b"
            },
            ".price-number-text": {
              "color": "#24262b"
            },
            ".price-caption": {
              "margin-top": "16px",
              "color": "#d70081"
            },
            ".mbr-section-btn": {
              "margin-top": "54px"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing10 shopm5\" group=\"Pricing\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected=\"\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked=\"\">\n        <header>Card</header>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected=\"\">2</option>\n            <option value=\"3\">3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked=\"\" condition=\"showTitle || showSubtitle\">\n        <input type=\"color\" title=\"Border Color\" name=\"cardBorderColor\" value=\"#767676\" condition=\"showBorder &amp;&amp; (showTitle || showSubtitle)\">\n        <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked=\"\">\n        <input type=\"checkbox\" title=\"Price Number\" name=\"showPriceNumber\" checked=\"\" condition=\"showPrice\">\n        <input type=\"checkbox\" title=\"Price Caption\" name=\"showCaption\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"color\" title=\"Card BG\" name=\"cardBg\" value=\"#efefef\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/nevo-12.jpg\" selected=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background5-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#080808\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showMainTitle || showMainSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                Tickets para el evento</h3>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">Never Ending Evolution on AI.</h5>\n        </div>\n        <div class=\"row align-items-stretch {{ contentAlign }}\">\n            <div class=\"card col-12 col-md-6 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-title-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Universo</b></h5>\n                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">&nbsp;(Luna + Marte)</h6>\n                    </div>\n                    <div class=\"card-number-wrap\" mbr-if=\"showPrice\">\n                        <p class=\"price-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price-text\">\n                            $15,120</p>\n                        <p class=\"price-number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showPriceNumber\" data-app-selector=\".price-number-text\">&nbsp;MXN + IVA</p>\n                    </div>\n                    <p class=\"price-caption mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCaption\" data-app-selector=\".price-caption\"><i><b>Hasta el 31 de enero</b></i><i style=\"\"><br>Luego $ 18,900 MXN + IVA (Por persona)</i><br></p>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><br><b>Pase corporativo</b> (5 personas)<br><b>$ 61,992 MXN + IVA</b> Hasta el 31 de enero<br><br><b>Perfil de Asistentes:</b> C-Level<br><br><b>Incluye:</b><br>• Entrada para los 2 días (Evento completo - Luna + Marte)<br>• Coffee break<br>• Idioma de conferencias español e inglés (traducción simultánea a español)<br>\n                    </p>\n\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"\" class=\"btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Comprar</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-title-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Luna</b></h5>\n                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">(Acceso on-line)</h6>\n                    </div>\n                    <div class=\"card-number-wrap\" mbr-if=\"showPrice\">\n                        <p class=\"price-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price-text\">\n                            $4,500&nbsp;</p>\n                        <p class=\"price-number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showPriceNumber\" data-app-selector=\".price-number-text\">MXN + IVA</p>\n                    </div>\n                    <p class=\"price-caption mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCaption\" data-app-selector=\".price-caption\"><b><i>Hasta el 31 de enero</i></b><br><i>Luego $ 7,500 MXN + IVA (Por persona)</i><br></p>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><br><b>Perfil de Asistentes: <br></b>C-Level, Directivos<br><br><b>Incluye:</b><br>• Entrada en Línea para los 2 días (Conferencias)<br>• Idioma de conferencias español e inglés (traducción simultánea a español)<br></p>\n\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"\" class=\"btn btn-secondary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Comprar</a></div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-title-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                        <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Luna</b></h5>\n                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">(Acceso on-line)</h6>\n                    </div>\n                    <div class=\"card-number-wrap\" mbr-if=\"showPrice\">\n                        <p class=\"price-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price-text\">\n                            $9,900&nbsp;</p>\n                        <p class=\"price-number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showPriceNumber\" data-app-selector=\".price-number-text\">\n                            MXN + IVA</p>\n                    </div>\n                    <p class=\"price-caption mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCaption\" data-app-selector=\".price-caption\"><b><i>$ 7,500 MXN + IVA (Por persona) Hasta el 14 de Febrero</i></b><br></p>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><br><b>Perfil de Asistentes:</b> C-Level, Directivos<br> <br><b>Incluye:</b><br>• Entrada en Línea para los 2 días (Conferencias)<br>• Idioma de conferencias español e inglés (traducción simultánea a español)</p>\n\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons=\"\" mbr-theme-style=\"display-7\"><a href=\"\" class=\"btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Comprar</a></div>\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n</section>",
