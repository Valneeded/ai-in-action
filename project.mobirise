tn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn More</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card": {
              "width": "100%"
            },
            "& when (@addBlockAmount = \"1\")": {
              ".card:nth-child(odd)": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            "& when (@addBlockAmount = \"2\")": {
              ".card:nth-child(even)": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            "& when (@addBlockAmount = \"4\")": {
              ".card": {
                ".add__block": {
                  "display": "none"
                }
              }
            },
            ".add__block": {
              "margin-top": "35px",
              ".add__block_image": {
                "width": "170px",
                "img": {
                  "width": "100%",
                  "border-radius": "6px"
                }
              },
              ".add__block_content": {
                "margin-left": "30px",
                "max-width": "270px"
              },
              ".add__block_title": {
                "margin-bottom": "0"
              },
              ".add__block_text": {
                "margin-top": "15px",
                "margin-bottom": "0",
                "color": "#919dab"
              }
            },
            ".row": {
              "margin": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "0"
            },
            ".step-container": {
              "margin-top": "25px"
            },
            ".padding__bot": {
              "padding-bottom": "50px"
            },
            ".step-text-content": {
              "padding-top": "10px"
            },
            ".mbr-step-title": {
              "margin-bottom": "0",
              "font-weight": "500",
              "color": "#d70081"
            },
            ".mbr-step-text": {
              "margin-bottom": "0",
              "margin-top": "20px",
              "color": "#232323"
            },
            ".mbr-section-btn": {
              "margin-top": "20px",
              ".btn": {
                "font-weight": "500"
              }
            },
            ".step": {
              "display": "flex",
              "width": "(@stepSize * 2px)",
              "height": "(@stepSize * 2px)",
              "font-size": "~\"calc((@{stepSize}px) - 2px)\"",
              "margin-bottom": "0",
              "border-radius": "50%",
              "border": "2px solid @lineColor",
              "background-color": "@lineColor",
              "font-weight": "500",
              "color": "#000000",
              "& when (@stepSize > 24px)": {
                "@media (max-width: 767px)": {
                  "width": "48px",
                  "height": "48px",
                  "font-size": "24px"
                }
              }
            },
            "@media (min-width: 400px)": {
              ".add__block": {
                "display": "flex"
              },
              ".step-element": {
                "display": "flex"
              },
              ".mbr-section-btn": {
                "margin-top": "20px",
                "margin-left": "~\"calc((@{stepSize} * 2px) + 70px)\"",
                ".btn": {
                  "margin-left": "0"
                }
              },
              ".separline": {
                "position": "relative",
                "&:after": {
                  "top": "(@stepSize * 2px)",
                  "left": "(@stepSize - 2px)",
                  "position": "absolute",
                  "content": "\"\"",
                  "width": "2px",
                  "height": "~\"calc(100% - (@{stepSize}px) * 2)\"",
                  "background-color": "@lineColor",
                  "& when (@stepSize > 24px)": {
                    "@media (max-width: 767px)": {
                      "top": "52px",
                      "left": "22px",
                      "height": "~\"calc(100% - 56px)\""
                    }
                  }
                }
              },
              ".step-text-content": {
                "margin-left": "70px"
              }
            },
            "@media (max-width: 400px)": {
              ".add__block_title": {
                "margin-top": "30px"
              },
              ".add__block": {
                ".add__block_content": {
                  "margin-left": "0"
                }
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_cid": "tT37XOd1d6",
          "_anchor": "steps1-1m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
