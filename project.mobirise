          "_customHTML": "<section data-bs-version=\"5.1\" class=\"steps1 marketm4_steps1\" group=\"Steps\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Step Title\" name=\"showStepTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Step Text\" name=\"showStepText\" checked>\n\t\t<input type=\"checkbox\" title=\"Show Button\" name=\"showButtons\">\n\t\t<input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#f7f7f7\">\n\t\t<select title=\"Steps Count\" name=\"stepsAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\" selected>4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t\t<option value=\"7\">7</option>\n\t\t</select>\n\t\t<input type=\"range\" inline title=\"Step Size\" name=\"stepSize\" min=\"10\" max=\"30\" step=\"1\" value=\"20\">\n\t\t<select title=\"Show Image\" name=\"addBlockAmount\">\n\t\t\t<option value=\"1\">odd</option>\n\t\t\t<option value=\"2\">even</option>\n\t\t\t<option value=\"3\">all</option>\n\t\t\t<option value=\"4\" selected>none</option>\n\t\t</select>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg1.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-xl-10 col-lg-11\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n\t\t\t\t\tDía 01 / 07.05</h2>\n\n\t\t\t\t<div class=\"step-container\">\n\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t<div class=\"card\" mbr-class=\"{'separline padding__bot': stepsAmount > '1'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">•</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">12:15 - 13:00 pm - Ponencia<br><b>Decentralized AI</b><br></h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\"><b>Andrew Trask</b><br>Senior Research Scientist en Google DeepMind.</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/pasted-image-11-380x380.png\" alt=\"Mobirise\" title>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_content\">\n\t\t\t\t\t\t\t\t\t\t\t<h5 class=\"add__block_title ls2fw500 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_title\">JUAN ENRIQUEZ</h5>\n\t\t\t\t\t\t\t\t\t\t\t<p class=\"add__block_text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".add__block_text\">Managing Director at Excel Venture Management, LLC<br></p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"stepsAmount > 1\" mbr-class=\"{'separline padding__bot': stepsAmount > '2'}\">\n\t\t\t\t\t\t\t<div class=\"step-element\">\n\t\t\t\t\t\t\t\t<div class=\"step-wrapper\">\n\t\t\t\t\t\t\t\t\t<h3 class=\"step align-items-center justify-content-center\" data-app-selector=\".step\">•</h3>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"step-text-content\">\n\t\t\t\t\t\t\t\t\t<h4 class=\"mbr-step-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-step-title\" mbr-if=\"showStepTitle\">13:00 - 13.30 pm&nbsp;</h4>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-step-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-step-text\" mbr-if=\"showStepText\">Coffee Break</p>\n\t\t\t\t\t\t\t\t\t<div class=\"align-items-start add__block\" mbr-if=\"addBlockAmount\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"add__block_image\">\n\t\t\t\t\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/brian-green-1-320x320.jpg\" alt=\"Mobirise\" 